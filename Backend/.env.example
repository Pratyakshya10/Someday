# Someday — backend environment.
# Copy the values you need into Backend/.env and Frontend/.env (the Next runtime
# reads Frontend/.env). Never commit real secrets.

# Postgres (Supabase). Pooled for the app, direct for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase — Dashboard → Project Settings → API.
# SUPABASE_URL is public (https://<project-ref>.supabase.co).
# SUPABASE_ANON_KEY is the public "anon" key — used for auth (email/password,
#   Google). Safe to expose, but data is still protected: row-level security is
#   ON with no policies, so the anon key can't read the app's tables directly.
# SUPABASE_SERVICE_ROLE_KEY is SECRET — the "service_role" key. Server-side only;
#   it bypasses RLS and must never reach the browser.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Resend — outbound email for Scheduled Messages (resend.com → API Keys).
# RESEND_API_KEY is SECRET (server-side only).
# RESEND_FROM is the sender. Use onboarding@resend.dev until you verify a
#   domain in Resend (Domains → Add Domain, then add the SPF/DKIM records at
#   your registrar) — the sandbox sender can only email your own Resend
#   account address. Once a domain is verified, switch to an address on it,
#   e.g. RESEND_FROM="Someday <letters@yourdomain.com>".
RESEND_API_KEY=""
RESEND_FROM="Someday <onboarding@resend.dev>"

# Delivery — the cron endpoint that sends due messages (/api/cron/deliver).
# CRON_SECRET protects it: the scheduler must send it as
#   "Authorization: Bearer <secret>" (or ?secret=<secret>). Generate any random
#   string. APP_URL is the public origin used to build reveal links; if unset,
#   the request's own origin is used (fine for local dev).
CRON_SECRET=""
APP_URL=""
