// Someday — database schema.
//
// Prisma reads this ONE file to do two jobs:
//   1) build/update the real tables in your Supabase database (migrations)
//   2) generate a typed client your code uses to query them (db.capsule.create…)

generator client {
  provider = "prisma-client-js"
  // "native" builds the engine for local dev; the rhel target is what Vercel's
  // serverless runtime (Amazon Linux) needs, so the deployed app can query.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection — the app uses this at runtime
  directUrl = env("DIRECT_URL")   // direct connection — used only for migrations
}

// ─────────────────────────────────────────────────────────────
// Enums — a value that must be ONE of a fixed set. Postgres enforces
// this, so an invalid value can never get into the database.
// ─────────────────────────────────────────────────────────────

enum CapsuleType {
  solo
  group
}

enum UnlockType {
  date
  location
  milestone
}

enum CapsuleStatus {
  draft
  sealed
  unlocked
}

// The kinds of media that can ride along with a letter.
enum AttachmentKind {
  voice
  photo
  video
}

// A person's role on a group capsule.
enum MemberRole {
  owner  // created it; edits meta, manages people, seals
  editor // writes their own note + media
  viewer // can only read it, once opened
}

// Delivery lifecycle of a message scheduled to a contact.
enum ScheduledStatus {
  draft     // still being written
  scheduled // locked in with a send time
  sending   // claimed by a delivery run, in flight — see claimDueMessage()
  sent
  failed
  canceled
}

// How often a scheduled message repeats.
enum Recurrence {
  none
  yearly
}

// ─────────────────────────────────────────────────────────────
// Capsule — one sealed time capsule. Becomes a table named "capsules".
// Each line below is one column.
// ─────────────────────────────────────────────────────────────

model Capsule {
  // Primary key: a unique id for every row. The DB generates a UUID
  // automatically. @db.Uuid stores it as Postgres' real `uuid` type.
  id String @id @default(uuid()) @db.Uuid

  // The owner = the logged-in user's id from Supabase Auth. Supabase manages
  // the users table for us, so here we just store that id.
  ownerId String @map("owner_id") @db.Uuid

  // Solo or group. Defaults to solo.
  type CapsuleType @default(solo)

  // ── The letter itself ──────────────────────────────────────
  // Which starter prompt the writer chose ("future", "miss", …). Free text so
  // the app can add templates without a migration.
  template String?

  // The "To —" line at the top of the letter, e.g. "Future Me".
  recipient String?

  // A short title for the capsule, shown in the vault.
  title String?

  // The letter's body — the actual words being sealed.
  body String?

  // Its stage of life: draft → sealed → unlocked. Starts as draft.
  status CapsuleStatus @default(draft)

  // How it unlocks. Phase 1 uses date; location/milestone come later.
  unlockType UnlockType @default(date) @map("unlock_type")

  // The delivery date. The "?" makes it OPTIONAL (a draft has none yet).
  unlockDate DateTime? @map("unlock_date")

  // Location unlock: opens when the reader is within `unlock_radius_m` metres of
  // (lat, lng). The label is a human name for the place ("our old street").
  unlockLat        Float?  @map("unlock_lat")
  unlockLng        Float?  @map("unlock_lng")
  unlockRadiusM    Int?    @map("unlock_radius_m")
  unlockPlaceLabel String? @map("unlock_place_label")

  // Milestone unlock: opens when the reader confirms this life event happened.
  unlockMilestone String? @map("unlock_milestone")

  // Opt-in to share an anonymized version on the community wall after unlock.
  isPublic Boolean @default(false) @map("is_public")

  // Timestamps. Optional ones stay null until that event happens.
  sealedAt   DateTime? @map("sealed_at")
  unlockedAt DateTime? @map("unlocked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // When the "your capsule is ready" email went out. Set once, and used as a
  // guard — whichever path actually triggers the unlock (a page visit, an
  // owner action, the cron sweep) sends it, but only the first one.
  unlockNotifiedAt DateTime? @map("unlock_notified_at")

  // A solo capsule has no CapsuleMember row for its owner, so their own
  // "have I looked since it unlocked" state lives here. Group capsules use
  // CapsuleMember.viewedAt per member (owner included) instead.
  ownerViewedUnlockAt DateTime? @map("owner_viewed_unlock_at")

  // Media sealed alongside the letter. Deleting a capsule deletes its media.
  attachments Attachment[]

  // Group capsules: who's in it, pending invites, and each person's note.
  members       CapsuleMember[]
  invites       CapsuleInvite[]
  contributions Contribution[]

  // If set, this capsule is the content of a message scheduled to a contact
  // (rather than a self/group capsule shown in the vault).
  scheduled ScheduledMessage?

  // The real table name in the database (snake_case, plural).
  @@map("capsules")
}

// ─────────────────────────────────────────────────────────────
// CapsuleMember — one person's membership + role on a group capsule.
// ─────────────────────────────────────────────────────────────

model CapsuleMember {
  id String @id @default(uuid()) @db.Uuid

  capsuleId String  @map("capsule_id") @db.Uuid
  capsule   Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)

  userId String     @map("user_id") @db.Uuid // Supabase user id
  role   MemberRole

  createdAt DateTime @default(now()) @map("created_at")

  // Last time this member actually looked at the capsule — compared against
  // Capsule.unlockedAt to know whether it's newly unlocked for them.
  viewedAt DateTime? @map("viewed_at")

  @@unique([capsuleId, userId])
  @@index([userId])
  @@map("capsule_members")
}

// ─────────────────────────────────────────────────────────────
// CapsuleInvite — a way in. A link invite (email null) can be used by anyone
// who has the token; an email invite is claimed by whoever signs in with that
// address. `role` is the access granted on join.
// ─────────────────────────────────────────────────────────────

model CapsuleInvite {
  id String @id @default(uuid()) @db.Uuid

  capsuleId String  @map("capsule_id") @db.Uuid
  capsule   Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)

  token String     @unique
  email String?    // null = shareable link; set = invite for a specific address
  role  MemberRole @default(editor)

  acceptedBy String?   @map("accepted_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([capsuleId])
  @@map("capsule_invites")
}

// ─────────────────────────────────────────────────────────────
// Contribution — one member's note within a group capsule (the owner and each
// editor get one). Media is linked by uploader (Attachment.owner_id = author).
// ─────────────────────────────────────────────────────────────

model Contribution {
  id String @id @default(uuid()) @db.Uuid

  capsuleId String  @map("capsule_id") @db.Uuid
  capsule   Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)

  authorId String @map("author_id") @db.Uuid
  body     String @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([capsuleId, authorId])
  @@map("contributions")
}

// ─────────────────────────────────────────────────────────────
// Attachment — one piece of media (voice note, photo, or short film)
// belonging to a capsule. The bytes live in object storage; this row keeps
// the pointer (storagePath) plus enough metadata to render it.
// ─────────────────────────────────────────────────────────────

model Attachment {
  id String @id @default(uuid()) @db.Uuid

  capsuleId String  @map("capsule_id") @db.Uuid
  capsule   Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)

  // Denormalized owner id — lets us authorize a read/delete without a join.
  ownerId String @map("owner_id") @db.Uuid

  kind AttachmentKind

  // Where the bytes live in the storage bucket, e.g. "<owner>/<capsule>/<id>.webm".
  storagePath String @map("storage_path")

  mimeType  String @map("mime_type")
  sizeBytes Int    @map("size_bytes")

  // Length in seconds for voice / video (null for photos).
  durationSec Int? @map("duration_sec")

  // A short handwritten-style note under a photo/video, e.g. "the last
  // morning there". Null for voice notes and for media without one.
  caption String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([capsuleId])
  @@map("attachments")
}

// ─────────────────────────────────────────────────────────────
// Contact — someone a user can schedule a message to. Scoped to the owner.
// ─────────────────────────────────────────────────────────────

model Contact {
  id String @id @default(uuid()) @db.Uuid

  ownerId String @map("owner_id") @db.Uuid // Supabase user id who owns this contact

  name  String
  email String
  phone String? // reserved for a future SMS channel

  createdAt DateTime @default(now()) @map("created_at")

  scheduledMessages ScheduledMessage[]

  @@unique([ownerId, email])
  @@index([ownerId])
  @@map("contacts")
}

// ─────────────────────────────────────────────────────────────
// ScheduledMessage — a letter (its content lives in a linked Capsule) addressed
// to a Contact, to be delivered by email at `sendAt`.
// ─────────────────────────────────────────────────────────────

model ScheduledMessage {
  id String @id @default(uuid()) @db.Uuid

  ownerId String @map("owner_id") @db.Uuid // Supabase user id who scheduled it

  // Unguessable token for the public reveal link emailed to the recipient.
  // Generated by the database so existing rows are backfilled too.
  token String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // The content (letter + media) reuses a Capsule, one-to-one.
  capsuleId String  @unique @map("capsule_id") @db.Uuid
  capsule   Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)

  // Who it's for. Null while the letter is still a draft with no recipient
  // chosen yet; required by the time it's scheduled.
  contactId String?  @map("contact_id") @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // When to send. Null while it's still a draft.
  sendAt DateTime? @map("send_at")

  status     ScheduledStatus @default(draft)
  recurrence Recurrence      @default(none)
  occasion   String?

  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") // last touched — used to cool down retries of a failed send

  @@index([ownerId])
  @@index([status, sendAt]) // the delivery worker scans due, scheduled rows
  @@map("scheduled_messages")
}

// ─────────────────────────────────────────────────────────────
// Journal — a private daily entry, separate from the capsule/letter
// lifecycle: always editable, never sealed, one per calendar day.
// ─────────────────────────────────────────────────────────────

model JournalEntry {
  id String @id @default(uuid()) @db.Uuid

  ownerId String @map("owner_id") @db.Uuid

  // The calendar day this entry belongs to (date-only). The client sends its
  // own local YYYY-MM-DD, same convention as a capsule's delivery date.
  entryDate DateTime @map("entry_date") @db.Date

  body String  @default("")
  mood String? // one emoji, free text rather than an enum — the set can grow without a migration

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attachments JournalAttachment[]

  @@unique([ownerId, entryDate])
  @@index([ownerId])
  @@map("journal_entries")
}

// Mirrors Attachment's shape. Not reusing Attachment directly — its capsuleId
// FK is non-nullable and hardcoded, so a parallel model is simpler than
// retrofitting polymorphism onto it.
model JournalAttachment {
  id String @id @default(uuid()) @db.Uuid

  entryId String       @map("entry_id") @db.Uuid
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  ownerId String @map("owner_id") @db.Uuid

  kind AttachmentKind

  storagePath String @map("storage_path")
  mimeType    String @map("mime_type")
  sizeBytes   Int    @map("size_bytes")
  durationSec Int?   @map("duration_sec")
  caption     String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entryId])
  @@map("journal_attachments")
}
