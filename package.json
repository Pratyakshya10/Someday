{
  "name": "someday",
  "version": "0.1.0",
  "private": true,
  "description": "Someday — a digital time capsule app. Write letters to your future self, seal them, and have them delivered on a chosen date.",
  "workspaces": [
    "Frontend",
    "Backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace someday-frontend",
    "build": "npm run build --workspace someday-frontend",
    "start": "npm run start --workspace someday-frontend",
    "lint": "npm run lint --workspace someday-frontend",
    "prisma:generate": "npm run prisma:generate --workspace @someday/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace @someday/backend",
    "prisma:studio": "npm run prisma:studio --workspace @someday/backend",
    "db:push": "npm run db:push --workspace @someday/backend"
  }
}
